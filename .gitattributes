# GitHub's automatically generated release archives use git archive. Keep the
# reproducible admin CSS toolchain in Git while omitting it from production ZIPs.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/tailwind.admin.config.js export-ignore
/assets/admin/tailwind.input.css export-ignore
/assets/admin/style.css export-ignore
/tests export-ignore
